MONGO_URI=
JWT_SECRET=
PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
NODE_ENV=development
# Required in production, for example https://skillcheck.example.com
APP_ORIGIN=
# Use 0 for direct access; set only after confirming the host's proxy hop count.
TRUST_PROXY=0
# Optional local preview of Frontend/dist; production always serves the build.
SERVE_FRONTEND=false
